{:paths ["src" "resources"]
 :deps  {org.clojure/clojure                {:mvn/version "1.12.1"}
         metosin/jsonista                   {:mvn/version "0.3.13"}
         metosin/malli                      {:mvn/version "0.19.1"}
         com.github.seancorfield/next.jdbc  {:mvn/version "1.3.955"}
         com.zaxxer/HikariCP                {:mvn/version "6.3.0"}
         org.postgresql/postgresql          {:mvn/version "42.7.5"}
         metosin/reitit-ring                {:mvn/version "0.9.1"}
         http-kit/http-kit                  {:mvn/version "2.8.0"}
         ;; phase 9a: JWT verification for the OIDC relying party —
         ;; latest Clojars release (2024), Apache-2.0, brings
         ;; buddy-core's JWK↔Java-key conversions
         buddy/buddy-sign                   {:mvn/version "3.6.1-359"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps  {org.clojure/test.check {:mvn/version "1.1.1"}
                       lambdaisland/kaocha    {:mvn/version "1.91.1392"}}
         :main-opts   ["-m" "kaocha.runner"]}
  :dev  {:extra-paths ["dev"]}
  ;; the affordance-following CLI (phase 10):
  ;;   clojure -M:cli http://localhost:8010 index
  :cli  {:main-opts ["-m" "waymark10.cli"]}}}
