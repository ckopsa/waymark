;; waymark10's shipped clj-kondo config: the def- forms resolve as
;; defs (no unresolved-symbol noise), and defresource's literal map
;; gets the same key-closure findings the runtime declaration gate
;; enforces — in the editor, before the REPL ever sees the typo.
{:lint-as {waymark10.declare/defaction    clojure.core/def
           waymark10.declare/defderived   clojure.core/def
           waymark10.declare/defguard     clj-kondo.lint-as/def-catch-all
           waymark10.resource/defhandler  clojure.core/defn
           waymark10.guards/defguard      clojure.core/defn
           waymark10.dsl/defaction        clojure.core/def
           waymark10.dsl/defderived       clojure.core/def
           waymark10.dsl/defguard         clj-kondo.lint-as/def-catch-all
           waymark10.dsl/defhandler       clojure.core/defn
           waymark10.dsl/defguardfn       clojure.core/defn
           waymark10.dsl/defalias         clojure.core/def}
 :hooks {:analyze-call {waymark10.resource/defresource hooks.waymark10.resource/defresource
                        waymark10.dsl/defresource      hooks.waymark10.resource/defresource}}
 :linters {:waymark10/unknown-key {:level :warning}}}
