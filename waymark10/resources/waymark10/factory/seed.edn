;; The factory seed (epic 00680418, T5): a self-hosted factory's first
;; boot. WAYMARK10_SEED=factory with FACTORY10_ONLY=1, and
;; WAYMARK10_SEED_PARAMS naming
;;   owner       the house's first owner: the member id the identity
;;               gate gives the person when they sign in. On an OIDC
;;               house that is the token's `sub` claim, exactly; on a
;;               solo house, the solo owner's id. The person who signs
;;               in IS this member, born holding approver, manager
;;               and recovery-admin, and no second member is made.
;;               WAYMARK10_FIRST_OWNERS naming the same id adds
;;               nothing; naming another makes a second owner beside.
;;   repo        the repository the factory builds in: owner/repo
;;   bench_url   the bench's MCP endpoint
;;   model       the model the seats are held for, as the harness
;;               declares it (claude-opus-5)
;;   pull_token  the token localfire presents when it asks for fires
;;   mail_url    optional: a mail server's MCP endpoint; absent, no
;;               `mail` row is made
;;   trial       optional, true for a THROWAWAY house that runs
;;               onboarding trials with nobody present. WARNING: it
;;               takes the person out of the loop. The bench's (and
;;               mail's) writes go out on a reason instead of a
;;               person's tap, the mayor holds the owner's onboarding
;;               doors, seats' parks and budgets, the repository's
;;               policy, the runner and secret create, and its key
;;               can be minted from inside the container:
;;                 java -cp "$(cat /app/classpath)" clojure.main \
;;                   -m workqueue10.main mint-mayor-key
;;               prints a one-time key for the `mayor` seat, and
;;               refuses on a house not seeded with `trial`. Never
;;               give it to a house a person keeps. Each trial step
;;               below is the step before it, under `:when-param`,
;;               and that one is under `:unless-param`: an ordinary
;;               house is exactly the seed without it
;;               (factory_seed_test holds the pairs together).
;;
;; It is :live-ok: it loads on a fresh engine. On one that already has
;; members and no marker the boot skips it with one warning and boots
;; on, and the marker skips it on every later boot.
;; Every step walks a door as the owner, except the :find, which names
;; domain `factory`: the boot makes that row before the seed runs, and
;; the mayor and the two judges sit in it. Each fired seat then gets its
;; schedule on the pull link (`:schedule`), so the owner's fire on it
;; reaches localfire with no schedule made by hand.
{:seed "factory"
 :version 2
 :live-ok true
 :cast
 ;; the owner holds `approver`, so a held power call has someone to
 ;; allow it
 {:owner  {:id [:param :owner] :display [:param :owner] :type :human
           :roles ["approver"]}
  :claude {:id "claude" :display "Claude" :type :agent :acts-for :owner}}
 :steps
 [{:find :domain :where {:name "factory"} :ref :factory}
  ;; the two starter judgments, promoted: the judges' seats name them
  {:as :owner :template "draft-ticket" :ref :draft-ticket}
  {:as :owner :kind :judgment :on :draft-ticket :action "promote"}
  {:as :owner :template "sitting" :ref :sitting
   :params {:ticket_repo [:param :repo]}}
  {:as :owner :kind :judgment :on :sitting :action "promote"}
  ;; the bench: its powers are the tokens the seats' scopes name. A
  ;; bench that does not answer yet leaves the row dark, and a person's
  ;; mark_live brings it up. Its writes on the forge wait on a person's
  ;; tap, and it creates repositories with the second token below.
  {:as :owner :kind :secret :ref :bench-repo
   :create {:name "bench-repo"
            :note "A GitHub token that may create repositories in the owner's account: the bench's X-Bench-Repo-Token."}}
  {:as :owner :kind :mcp_server :ref :bench :unless-param :trial
   :create {:name "bench"
            :transport "http"
            :url [:param :bench_url]
            :headers [{:name "X-Bench-Repo-Token" :x-secret-ref [:ref :bench-repo]}]
            :powers [{:power "bench.find" :tools ["find"] :why false
                      :constraints ["repo" "path"]}
                     {:power "bench.read" :tools ["read" "prepare" "status"] :why false
                      :constraints ["repo" "path"]}
                     {:power "bench.symbols" :tools ["symbols" "read_symbol"] :why false
                      :constraints ["repo" "path"]}
                     {:power "bench.edit" :tools ["edit"] :why false
                      :constraints ["repo" "path"]}
                     {:power "bench.edit_many" :tools ["edit_many"] :why false
                      :constraints ["repo"]}
                     {:power "bench.check" :tools ["check"] :why false
                      :constraints ["repo"]}
                     {:power "bench.test" :tools ["test" "test_result"] :why false
                      :constraints ["repo"]}
                     {:power "bench.pull" :tools ["pull"] :why false
                      :constraints ["repo"]}
                     {:power "bench.feedback" :tools ["feedback"] :why false
                      :constraints ["repo"]}
                     {:power "bench.history" :tools ["history"] :why false
                      :constraints ["repo"]}
                     {:power "bench.log" :tools ["log"] :why false
                      :constraints ["repo"]}
                     {:power "bench.rerun" :tools ["rerun"] :why false
                      :constraints ["repo"]}
                     {:power "bench.secret_list" :tools ["secret_list"] :why false
                      :constraints ["repo"]}
                     {:power "bench.run_status" :tools ["run_status"] :why false
                      :constraints ["repo"]}
                     {:power "bench.secret" :tools ["secret_set"] :approval "person"
                      :shown ["repo" "name" "value"] :constraints ["repo"]}
                     {:power "bench.merge" :tools ["merge"] :approval "person"
                      :shown ["repo" "number" "head_sha"] :constraints ["repo"]}
                     {:power "bench.dispatch" :tools ["dispatch"] :approval "person"
                      :shown ["repo" "workflow" "inputs"] :constraints ["repo"]}
                     {:power "bench.repo_create" :tools ["create_repo"] :approval "person"
                      :shown ["name" "private"] :needs_headers ["X-Bench-Repo-Token"]}]}}
  ;; the trial's bench: the same, its four writes on a reason alone
  {:as :owner :kind :mcp_server :ref :bench :when-param :trial
   :create {:name "bench"
            :transport "http"
            :url [:param :bench_url]
            :headers [{:name "X-Bench-Repo-Token" :x-secret-ref [:ref :bench-repo]}]
            :powers [{:power "bench.find" :tools ["find"] :why false
                      :constraints ["repo" "path"]}
                     {:power "bench.read" :tools ["read" "prepare" "status"] :why false
                      :constraints ["repo" "path"]}
                     {:power "bench.symbols" :tools ["symbols" "read_symbol"] :why false
                      :constraints ["repo" "path"]}
                     {:power "bench.edit" :tools ["edit"] :why false
                      :constraints ["repo" "path"]}
                     {:power "bench.edit_many" :tools ["edit_many"] :why false
                      :constraints ["repo"]}
                     {:power "bench.check" :tools ["check"] :why false
                      :constraints ["repo"]}
                     {:power "bench.test" :tools ["test" "test_result"] :why false
                      :constraints ["repo"]}
                     {:power "bench.pull" :tools ["pull"] :why false
                      :constraints ["repo"]}
                     {:power "bench.feedback" :tools ["feedback"] :why false
                      :constraints ["repo"]}
                     {:power "bench.history" :tools ["history"] :why false
                      :constraints ["repo"]}
                     {:power "bench.log" :tools ["log"] :why false
                      :constraints ["repo"]}
                     {:power "bench.rerun" :tools ["rerun"] :why false
                      :constraints ["repo"]}
                     {:power "bench.secret_list" :tools ["secret_list"] :why false
                      :constraints ["repo"]}
                     {:power "bench.run_status" :tools ["run_status"] :why false
                      :constraints ["repo"]}
                     {:power "bench.secret" :tools ["secret_set"] :approval "why"
                      :shown ["repo" "name" "value"] :constraints ["repo"]}
                     {:power "bench.merge" :tools ["merge"] :approval "why"
                      :shown ["repo" "number" "head_sha"] :constraints ["repo"]}
                     {:power "bench.dispatch" :tools ["dispatch"] :approval "why"
                      :shown ["repo" "workflow" "inputs"] :constraints ["repo"]}
                     {:power "bench.repo_create" :tools ["create_repo"] :approval "why"
                      :shown ["name" "private"] :needs_headers ["X-Bench-Repo-Token"]}]}}
  ;; the repository: what selfhost/repo-kit adds to it is a tests.yml
  ;; dispatched with an `only` input, one job named `tests`, and
  ;; docs/orientation.md. No clone_url: a GitHub repository is cloned
  ;; from https://github.com/<repo>. Its `orgs` lane makes it the
  ;; house's orgs repository (ticket 36b1cd39): the one home
  ;; org-plan-onboarding/orgs-repository reads, so a plan's onboarding
  ;; seat writes, and mints its change, here and not in the kit's.
  {:as :owner :kind :repo_policy :ref :policy
   :create {:repository [:param :repo]
            :lanes [{:name "orgs" :paths ["orgs/**"]}]
            :required_checks ["tests"]
            :test {:workflow "tests.yml" :input "only"}
            :orientation "docs/orientation.md"}}
  ;; the pull link localfire asks for fires on, and the model whose
  ;; seats fire through it. The prices are a frontier model's; restate
  ;; the model when its vendor's differ.
  {:as :owner :kind :model :ref :model
   :create {:name [:param :model]
            :display [:param :model]
            :vendor "anthropic"
            :tier "frontier"
            :price_input_per_mtok 5M
            :price_output_per_mtok 25M
            :price_cache_read_per_mtok 0.5M
            :price_cache_write_per_mtok 6.25M}}
  ;; its id is fixed and documented, the same on every fresh engine, so
  ;; compose hands it to localfire as a plain default (first-run R-5.5).
  ;; An id is per database, so it collides with nothing.
  {:as :owner :kind :runner_link :ref :pull
   :id "10ca1f12-e000-4000-8000-000000000001"
   :create {:provider "localfire" :delivery "pull"
            :fire_token [:param :pull_token]
            :pools [{:kind "model" :id [:ref :model] :rank 0}]}}
  ;; the four seats, each held for that model
  ;; the mayor runs onboarding: its scope, given here and not in the
  ;; shared template, adds the org_plan and its parts, the seats it
  ;; stands up inside a ceiling that covers the onboarding and code
  ;; seat templates, the house's rows it creates, and the bench's
  ;; powers on the repository
  {:as :owner :template "mayor" :ref :mayor :unless-param :trial
   :params {:repos [:param :repo] :domain "factory" :domain_id [:ref :factory]}
   :with {:held_for [[:ref :model]]
          :delegates {:budget_usd_per_week 25M :sitting_budget_tokens 600000
                      :scope [{:kind "org_plan" :actions ["create" "ask" "log_workarounds" "propose" "go_live" "retire"]}
                              {:kind "plan_part" :actions ["create" "restate" "agree" "drop"]}
                              {:kind "ticket" :actions ["create" "complete" "ungroom"]}
                              {:kind "change" :actions ["submit" "stall" "discard"]}
                              {:kind "bench.find" :actions []}
                              {:kind "bench.read" :actions []}
                              {:kind "bench.symbols" :actions []}
                              {:kind "bench.edit" :actions []}
                              {:kind "bench.edit_many" :actions []}
                              {:kind "bench.check" :actions []}
                              {:kind "bench.test" :actions []}
                              {:kind "bench.pull" :actions []}
                              {:kind "bench.feedback" :actions []}
                              {:kind "bench.history" :actions []}
                              {:kind "bench.log" :actions []}
                              {:kind "bench.rerun" :actions []}]}
          :scope [{:kind "ticket" :actions ["create" "groom" "block" "unblock" "drop" "prioritize"
                                            "restate" "reopen" "show_evidence" "resume"]
                   :filter {:repo [:param :repo]}}
                  {:kind "change" :actions ["rework"]}
                  {:kind "verdict" :actions []}
                  {:kind "approval_request" :actions ["create"]}
                  {:kind "org_plan" :actions ["create" "write_brief" "seat_onboarder" "ask" "answer"]}
                  {:kind "plan_part" :actions ["create" "restate" "agree" "drop"]}
                  {:kind "watch" :actions ["create"]}
                  {:kind "seat" :actions ["create" "restate" "offer_key" "fire"]}
                  {:kind "model" :actions ["create"]}
                  {:kind "mcp_server" :actions ["create"]}
                  {:kind "held_call" :actions ["propose"]}
                  {:kind "bench.find" :actions [] :filter {:repo [:param :repo]}}
                  {:kind "bench.read" :actions [] :filter {:repo [:param :repo]}}
                  {:kind "bench.secret_list" :actions [] :filter {:repo [:param :repo]}}
                  {:kind "bench.run_status" :actions [] :filter {:repo [:param :repo]}}
                  {:kind "bench.secret" :actions [] :filter {:repo [:param :repo]}}
                  {:kind "bench.merge" :actions [] :filter {:repo [:param :repo]}}
                  {:kind "bench.dispatch" :actions [] :filter {:repo [:param :repo]}}
                  {:kind "bench.repo_create" :actions []}]}}
  ;; the trial's mayor: the same, and it also holds the owner's
  ;; onboarding doors, seats' parks and budgets, the repository's
  ;; policy, the runner and secret create. A guard that wants a person
  ;; or the plan's owner still refuses it: the trial counts those.
  {:as :owner :template "mayor" :ref :mayor :when-param :trial
   :params {:repos [:param :repo] :domain "factory" :domain_id [:ref :factory]}
   :with {:held_for [[:ref :model]]
          :delegates {:budget_usd_per_week 25M :sitting_budget_tokens 600000
                      :scope [{:kind "org_plan" :actions ["create" "ask" "log_workarounds" "propose" "go_live" "retire"]}
                              {:kind "plan_part" :actions ["create" "restate" "agree" "drop"]}
                              {:kind "ticket" :actions ["create" "complete" "ungroom"]}
                              {:kind "change" :actions ["submit" "stall" "discard"]}
                              {:kind "bench.find" :actions []}
                              {:kind "bench.read" :actions []}
                              {:kind "bench.symbols" :actions []}
                              {:kind "bench.edit" :actions []}
                              {:kind "bench.edit_many" :actions []}
                              {:kind "bench.check" :actions []}
                              {:kind "bench.test" :actions []}
                              {:kind "bench.pull" :actions []}
                              {:kind "bench.feedback" :actions []}
                              {:kind "bench.history" :actions []}
                              {:kind "bench.log" :actions []}
                              {:kind "bench.rerun" :actions []}]}
          :scope [{:kind "ticket" :actions ["create" "groom" "block" "unblock" "drop" "prioritize"
                                            "restate" "reopen" "show_evidence" "resume"]
                   :filter {:repo [:param :repo]}}
                  {:kind "change" :actions ["rework"]}
                  {:kind "verdict" :actions []}
                  {:kind "approval_request" :actions ["create"]}
                  {:kind "org_plan" :actions ["create" "write_brief" "seat_onboarder" "ask" "answer"
                                              "log_workarounds" "propose" "go_live" "refresh" "retire"]}
                  {:kind "plan_part" :actions ["create" "restate" "agree" "drop" "agree_many" "reopen"]}
                  {:kind "watch" :actions ["create"]}
                  {:kind "seat" :actions ["create" "restate" "offer_key" "fire" "park" "unpark" "set_budget"]}
                  {:kind "model" :actions ["create"]}
                  {:kind "mcp_server" :actions ["create"]}
                  {:kind "held_call" :actions ["propose"]}
                  {:kind "bench.find" :actions [] :filter {:repo [:param :repo]}}
                  {:kind "bench.read" :actions [] :filter {:repo [:param :repo]}}
                  {:kind "bench.secret_list" :actions [] :filter {:repo [:param :repo]}}
                  {:kind "bench.run_status" :actions [] :filter {:repo [:param :repo]}}
                  {:kind "bench.secret" :actions [] :filter {:repo [:param :repo]}}
                  {:kind "bench.merge" :actions [] :filter {:repo [:param :repo]}}
                  {:kind "bench.dispatch" :actions [] :filter {:repo [:param :repo]}}
                  {:kind "bench.repo_create" :actions []}
                  {:kind "repo_policy" :actions ["create" "restate"]}
                  {:kind "runner_link" :actions ["create" "restate" "retire" "restore" "set_pools"]}
                  {:kind "runner_provider" :actions ["restate"]}
                  {:kind "secret" :actions ["create"]}]}}
  {:as :owner :template "code-seat" :ref :code-seat
   :params {:repo [:param :repo]}
   :with {:held_for [[:ref :model]]}}
  {:as :owner :template "draft-judge" :ref :draft-judge
   :params {:repos [:param :repo] :judgment [:ref :draft-ticket]
            :domain "factory" :domain_id [:ref :factory]}
   :with {:held_for [[:ref :model]]}}
  {:as :owner :template "sitting-judge" :ref :sitting-judge
   :params {:judgment [:ref :sitting] :domain "factory" :domain_id [:ref :factory]}
   :with {:held_for [[:ref :model]]}}
  ;; each seat's schedule, its runner the pull link: the engine writes
  ;; it, and an interactive seat (the mayor, as its template seats it)
  ;; gets none
  {:schedule :mayor :runners [[:ref :pull]]}
  {:schedule :code-seat :runners [[:ref :pull]]}
  {:schedule :draft-judge :runners [[:ref :pull]]}
  {:schedule :sitting-judge :runners [[:ref :pull]]}
  ;; GitHub access: one secret, made empty, that waits on the owner
  ;; until they paste the token (first-run R-5.2, R-5.4)
  {:as :owner :kind :secret :ref :github
   :create {:name "github"
            :note [:join ["A fine-grained GitHub token on " [:param :repo]
                          ": contents, pull requests and actions, read and write."]]}}
  ;; The setup cards (first-run R-5.2, R-7.1). Each step below is
  ;; `:fresh`: an engine that holds this seed's marker skips it, so an
  ;; engine seeded before them gets no new row or watch, and the setup
  ;; quest and first ticket an older seed made are kept as they are.
  ;;
  ;; the owner's first, empty org_plan, filed through the ordinary
  ;; create as the owner with no brief: it seats no onboarding seat
  ;; until its `write_brief`
  {:as :owner :kind :org_plan :ref :house :fresh true
   :create {:name "house"}}
  ;; the steps that must be done: setup is done when this holds nothing.
  ;; On a hosted engine (`hosted`, which the boot gives an engine with
  ;; sign-in) the runner's first pull is the operator's, not the owner's:
  ;; each watch's `hosted` twin below files Let seats run in Next steps,
  ;; where it may be set aside, instead of here
  {:as :owner :kind :watch :ref :setting-up :fresh true :unless-param :hosted
   :create {:name "Setting up"
            :required true
            :cues [{:kind "member" :actions [] :states ["active"]
                    :title "Connect your Claude"
                    :filter {:id [:cast :owner]}
                    :note "1. In Claude (claude.ai or the Claude app), open Settings, then Connectors, and add a custom connector.\n2. Name it after your house and give it this engine's address:\n{engine_url}\n3. Claude sends you here to sign in with your house account; allow it.\n4. Open a new chat with that connector on and say what you want this house to do. The Claude you connect is your mayor.\nYou know it worked when Claude answers from this house.\nAlready added it? Open a chat with it on; if Claude says it needs to sign in again, reconnect it."}
                   {:kind "runner_link" :actions [] :states ["live"]
                    :title "Let seats run"
                    :filter {:id [:ref :pull] :puller_seen_at_set "false"}
                    :note "Open localfire on 127.0.0.1:8112 and give it your Claude token: paste the one `claude setup-token` prints."
                    :note_hosted "Seats run once this engine's runner has pulled for the first time. That is the operator's to start; nothing here is yours to do."}]}}
  {:as :owner :kind :watch :ref :setting-up :fresh true :when-param :hosted
   :create {:name "Setting up"
            :required true
            :cues [{:kind "member" :actions [] :states ["active"]
                    :title "Connect your Claude"
                    :filter {:id [:cast :owner]}
                    :note "1. In Claude (claude.ai or the Claude app), open Settings, then Connectors, and add a custom connector.\n2. Name it after your house and give it this engine's address:\n{engine_url}\n3. Claude sends you here to sign in with your house account; allow it.\n4. Open a new chat with that connector on and say what you want this house to do. The Claude you connect is your mayor.\nYou know it worked when Claude answers from this house.\nAlready added it? Open a chat with it on; if Claude says it needs to sign in again, reconnect it.\nIf Claude says it could not register, tell your house's operator: the connector client is missing or not public."}]}}
  ;; the steps that may wait: each may be set aside with Not now
  {:as :owner :kind :watch :ref :next-steps :fresh true :unless-param :hosted
   :create {:name "Next steps"
            :cues [{:kind "secret" :actions [] :states ["active"]
                    :title "GitHub access"
                    :filter {:id [:ref :github] :value_set_at_set "false"}
                    :note "Paste your GitHub token: a fine-grained token on the repository, with contents, pull requests, actions and workflows read and write. It is never shown back."}
                   {:kind "org_plan" :actions ["write_brief"] :states ["drafting"]
                    :title "Say what the house is for"
                    :filter {:id [:ref :house] :brief_set "false"}
                    :note "Write a paragraph on what this house runs for you, in your own words. The onboarding seat turns it into a tree of parts for you to agree to."}]}}
  {:as :owner :kind :watch :ref :next-steps :fresh true :when-param :hosted
   :create {:name "Next steps"
            :cues [{:kind "runner_link" :actions [] :states ["live"]
                    :title "Let seats run"
                    :filter {:id [:ref :pull] :puller_seen_at_set "false"}
                    :note "Open localfire on 127.0.0.1:8112 and give it your Claude token: paste the one `claude setup-token` prints."
                    :note_hosted "Seats run once this engine's runner has pulled for the first time. That is the operator's to start; nothing here is yours to do."}
                   {:kind "secret" :actions [] :states ["active"]
                    :title "GitHub access"
                    :filter {:id [:ref :github] :value_set_at_set "false"}
                    :note "Paste your GitHub token: a fine-grained token on the repository, with contents, pull requests, actions and workflows read and write. It is never shown back."}
                   {:kind "org_plan" :actions ["write_brief"] :states ["drafting"]
                    :title "Say what the house is for"
                    :filter {:id [:ref :house] :brief_set "false"}
                    :note "Write a paragraph on what this house runs for you, in your own words. The onboarding seat turns it into a tree of parts for you to agree to."}]}}
  ;; mail, only when the boot names one: its sends wait on a person
  {:as :owner :kind :mcp_server :ref :mail :when-param :mail_url :unless-param :trial
   :create {:name "mail"
            :transport "http"
            :url [:param :mail_url]
            :powers [{:power "email.read" :tools ["read" "search"] :why false}
                     {:power "email.send" :tools ["send"] :approval "person"
                      :shown ["to" "subject"]}]}}
  ;; the trial's mail: the same, its sends on a reason alone
  {:as :owner :kind :mcp_server :ref :mail :when-param [:mail_url :trial]
   :create {:name "mail"
            :transport "http"
            :url [:param :mail_url]
            :powers [{:power "email.read" :tools ["read" "search"] :why false}
                     {:power "email.send" :tools ["send"] :approval "why"
                      :shown ["to" "subject"]}]}}]}
