;; localfire's config (spec-local-fire.md R-4.2).
;;
;; The path is the first argument to `clojure -M:serve`, or
;; LOCALFIRE_CONFIG, or `localfire.edn` beside the working directory.
;;
;; THIS FILE HOLDS NO SECRET. The bearer token is read from the
;; variable LOCALFIRE_TOKEN and from nowhere else (R-4.3). Mint one of
;; 128 bits, base64url, and export it in the service's environment:
;;
;;   LOCALFIRE_TOKEN=$(openssl rand -base64 16 | tr '+/' '-_' | tr -d '=')
;;
;; Then invoke `link` on the MODEL row with `{public-url}/fire/{routine}`
;; and that token, exactly as for a cloud Routine.
{;; the rig table (docs/routines/rigs.md) gives 8112
 :port 8112

 ;; where the engine and a person reach this server. It goes into every
 ;; run page URL, which the engine writes onto the schedule row as
 ;; `last_run_url`, so it must be reachable from both.
 :public-url "http://192.168.1.231:8112" ; big-colt

 ;; a clone of ckopsa/waymark-seat (R-8.1): CLAUDE.md,
 ;; .claude/settings.json, .claude/hooks/sitting-close.sh, and nothing
 ;; else. A person or a timer pulls it. The server copies it for each
 ;; run and never writes in it.
 :place "/srv/waymark-seat"

 ;; one directory per run, named by the session id. `paused/` under it
 ;; holds the pause files, so a pause survives a restart.
 :runs-dir "/var/lib/localfire/runs"

 ;; the Claude Code binary. Default "claude".
 :claude "claude"

 ;; the engine's MCP door, written into each run's mcp.json and reached
 ;; with --strict-mcp-config. The session's bearer at that door is the
 ;; person's own stored credential (R-8.2), not anything this file
 ;; holds.
 ;; The name is the cloud connector's, `Waymark`, so the tools are
 ;; `mcp__Waymark__…` as the seats' instructions spell them.
 ;;
 ;; :oauth is optional (R-8.2): the fixed OAuth client, for a door that
 ;; refuses dynamic registration. It must match the client the person
 ;; signed in with, `claude mcp add --client-id ... --callback-port ...`:
 ;; the same id and the same port. Both keys are required when the map
 ;; is there.
 ;;   :mcp {:name "Waymark" :url "https://work.kopsa.info/api/-/mcp"
 ;;         :oauth {:client-id "localfire-claude" :callback-port 8765}}
 :mcp {:name "Waymark" :url "https://work.kopsa.info/api/-/mcp"}

 ;; passed to --allowedTools, one argument each. This is the default.
 ;; Every built-in tool is off (--tools ""), whatever this says.
 :allowed-tools ["mcp__Waymark__*"]

 ;; when :claude is a wrapper that runs each session in a container,
 ;; the sitting-close hook (R-5.6) has to run there too, where the
 ;; transcript is. Both default to running it here, under this HOME.
 ;; :hook-via    ["/path/to/hook-in-container"]
 ;; :claude-home "/home/agent"

 ;; one routine per CLI model — the local copy of "one Routine for each
 ;; model" (docs/routines/ci-classifier.md). :model is required;
 ;; :max-concurrent defaults to 1, :max-run-seconds to 3600, and
 ;; :prompt to the fixed Routine prompt of R-6.1.
 :routines
 {"opus"   {:model "claude-opus-5"
            :max-concurrent 1
            :max-run-seconds 3600}
  "sonnet" {:model "claude-sonnet-5"
            :max-concurrent 2
            :max-run-seconds 3600}
  "haiku"  {:model "claude-haiku-4-5"
            :max-concurrent 1
            :max-run-seconds 900}}}
