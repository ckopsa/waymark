{:paths ["src"]
 :deps  {org.clojure/clojure  {:mvn/version "1.12.1"}
         waymark10/waymark10  {:local/root "../waymark10"}
         ;; the calendar is its own domain since waymark-6k5.2, and the
         ;; plan cites :event through a date-containment predicate — so
         ;; the meal plan depends on the calendar module rather than
         ;; keeping a second, read-only spelling of the same kind
         calendar10/calendar10 {:local/root "../calendar10"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps  {org.clojure/test.check {:mvn/version "1.1.1"}
                       lambdaisland/kaocha    {:mvn/version "1.91.1392"}}
         :main-opts   ["-m" "kaocha.runner"]}
  :dev  {:main-opts ["-m" "mealplan10.main"]}
  ;; make check10: the declaration-time gate — warnings on stdout,
  ;; exit 1 on a definition error; no database, no env
  :check {:main-opts ["-m" "waymark10.check" "mealplan10.main/check-resources"]}
  ;; make migrate10: print the schema plan; APPLY=1 executes,
  ;; DESTRUCTIVE=1 includes state renames
  :migrate {:main-opts ["-e" "((requiring-resolve 'mealplan10.main/migrate!))"]}
  ;; the one-time v9 → v10 data migration (the cutover): SOURCE_DSN +
  ;; MEALPLAN10_DSN; dry run by default, APPLY=1 executes
  :migrate-v9 {:main-opts ["-e" "((requiring-resolve 'mealplan10.migrate-v9/migrate!))"]}}}
