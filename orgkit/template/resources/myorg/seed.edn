;; myorg's seed: what a fresh engine holds the moment it boots this
;; org. The grammar is docs/orgkit.md § The seed: the demo seed's
;; :cast and :steps (docs/spec-demo-clones.md § 1) under the org's
;; :domains, :seats and :judgments.
{:seed "myorg"
 :version 1
 :org "myorg"
 :domains [{:name "myorg" :label "My Org" :ref :myorg}]
 ;; on the house, the :owner :id is the filing person's member id, a
 ;; member the seed reuses (seed.clj): the onboarding seat writes it
 ;; from the plan's owner. "owner" serves a memory engine only.
 :cast
 {:owner {:id "owner" :display "The Owner" :type :human :roles ["approver"]}}
 ;; the outside world, which only a clone loads: who outside the
 ;; business starts work, each a member whose :scope creates the kind
 ;; they send, and the world seat that plays their first week. An org
 ;; nobody outside starts work for says :world :none in org.edn instead
 :rehearsal
 {:cast {:client {:id "client" :display "A Client" :type :human
                  :scope [{:kind "item" :actions ["create"]}]}}
  :seats [{:template "world"
           :params {:brief "My Org does the work its clients send it."
                    :kinds "item" :cast "client" :day_one [:days 0]
                    :domain_id [:ref :myorg]}}]}
 ;; a seat is a factorykit template and its params, or a whole seat
 ;; map under :seat when no template walks the org's kinds
 ;; the org's mayor holds item's doors out of open, so an open item has
 ;; a leaver; its scope names only the org's own kinds
 :seats
 [{:template "org-mayor"
   :params {:org "myorg" :domain "myorg" :domain_id [:ref :myorg]
            :owner "owner" :budget_usd_per_week 8M
            :kinds [{:kind "item" :actions ["complete" "drop"]}]
            :wakes [{:kind "item" :actions ["create"]}]}}]
 ;; a judgment is a factorykit judgment template and its params
 :judgments
 [{:template "sitting" :params {:ticket_repo "owner/repo"}}]
 :steps
 [{:as :owner :kind :item :ref :first
   :create {:title "The first piece of work" :assignee "owner"}}]}
