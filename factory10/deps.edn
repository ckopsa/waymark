{:paths ["src"]
 :deps  {org.clojure/clojure  {:mvn/version "1.12.1"}
         waymark10/waymark10  {:local/root "../waymark10"}
         factorykit/factorykit {:local/root "../factorykit"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps  {org.clojure/test.check {:mvn/version "1.1.1"}
                       lambdaisland/kaocha    {:mvn/version "1.91.1392"}
                       ;; the org kit's template and its example org, so
                       ;; factory10.orgkit-test can load both modules
                       orgkit/template        {:local/root "../orgkit/template"}
                       orgs/example           {:local/root "../orgs/example"}
                       ;; an org whose rehearsal declares an integration,
                       ;; so factory10.rehearsal-seed-test loads its seed
                       orgs/landscape-rehearsal {:local/root "../orgs/landscape_rehearsal"}
                       ;; an org whose name holds an underscore, so
                       ;; factory10.two-words-org-test loads `two_words.org`
                       fixtures/two-words     {:local/root "fixtures/orgs/two_words"}
                       ;; an org whose release fans out to its content,
                       ;; so factory10.vanilla-plus-release-test walks it
                       orgs/vanilla-plus      {:local/root "../orgs/vanilla_plus"}}
         :main-opts   ["-m" "kaocha.runner"]}
  ;; make check-factory: the declaration-time gate — warnings on
  ;; stdout, exit 1 on a definition error; no database, no env
  :check {:main-opts ["-m" "waymark10.check" "factory10.main/check-resources"]}}}
