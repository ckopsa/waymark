{:paths ["src"]
 :deps  {org.clojure/clojure      {:mvn/version "1.12.1"}
         waymark10/waymark10      {:local/root "../waymark10"}
         ;; the calendar domain (waymark-6k5): its own module because
         ;; the calendar belongs to neither the meal plan nor the
         ;; queue — they both merely cite it. The chore, meal and
         ;; evening namespaces live under THIS app's src/ since the
         ;; consolidation cleanup (waymark-26j) — module prefixes,
         ;; not separate apps.
         calendar10/calendar10    {:local/root "../calendar10"}}
 :aliases
 {;; CI only: puts the AOT'd third-party library bytecode on the
  ;; classpath. Absent in a normal checkout and in the production
  ;; image, which runs from source — see waymark10/src/waymark10/aot.clj
  ;; for why the framework itself is deliberately NOT compiled.
  :aot {:extra-paths ["classes"]}
  :test {:extra-paths ["test"]
         :extra-deps  {org.clojure/test.check {:mvn/version "1.1.1"}
                       lambdaisland/kaocha    {:mvn/version "1.91.1392"}}
         :main-opts   ["-m" "kaocha.runner"]}
  :dev  {:main-opts ["-m" "workqueue10.main"]}
  ;; make check-queue: the declaration-time gate — warnings on
  ;; stdout, exit 1 on a definition error; no database, no env
  :check {:main-opts ["-m" "waymark10.check" "workqueue10.main/check-resources"]}
  ;; make migrate-queue: print the schema plan; APPLY=1 executes,
  ;; DESTRUCTIVE=1 includes state renames
  :migrate {:main-opts ["-e" "((requiring-resolve 'workqueue10.main/migrate!))"]}
  ;; the stale-price scraper (waymark-1qn): one polite pass over
  ;; ?state=tracked&price_is_stale=true against WORKQUEUE10_DSN;
  ;; SCRAPE_LIMIT / SCRAPE_DELAY_MS override politeness
  :scrape {:main-opts ["-e" "((requiring-resolve 'workqueue10.main/scrape!))"]}
  ;; the one-time v9 → v10 data migration (the cutover, kept for the
  ;; record): SOURCE_DSN + MEALPLAN10_DSN; dry run by default,
  ;; APPLY=1 executes
  :migrate-v9 {:main-opts ["-e" "((requiring-resolve 'mealplan10.migrate-v9/migrate!))"]}}}
