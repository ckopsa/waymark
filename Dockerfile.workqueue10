# Serves the workqueue10 app: a waymark10 engine on http-kit.
# Build:  make image-queue   (buildx arm64 → docker.kopsa.info/workqueue10:<tag>)
# The base is Docker Hub's library image, from the ECR Public mirror:
# an anonymous pull from Docker Hub is rate limited, and CI has none.
# BASE is an argument because ECR Public limits anonymous pulls by IP
# too, and a hosted runner shares its IP: image.yml names the same
# image on another mirror. A laptop build keeps this default.
ARG BASE=public.ecr.aws/docker/library/clojure:temurin-21-tools-deps-bookworm-slim
FROM ${BASE}

WORKDIR /app

# Dependency layer: the deps.edn files first, so a source-only change
# never re-downloads the world. -P prepares the full :dev classpath.
# The chore, meal and day-plan modules live under workqueue10/src since
# the consolidation cleanup (waymark-26j); calendar10 stays a module
# since the calendar became its own writable domain (waymark-6k5.2);
# factory10 joins it as the day job's module (waymark-fp62.6.2) —
# workqueue10.main requires it either way, and FACTORY10=1 decides
# whether this engine SERVES its kinds.
# EVERY :local/root in workqueue10/deps.edn must be copied here, or -P
# fails the build with "Local lib … not found" — which is how one of
# these was found.
COPY waymark10/deps.edn waymark10/deps.edn
COPY calendar10/deps.edn calendar10/deps.edn
COPY factory10/deps.edn factory10/deps.edn
COPY factorykit/deps.edn factorykit/deps.edn
COPY workqueue10/deps.edn workqueue10/deps.edn
# The classpath is resolved HERE and written to /app/classpath, so the
# CMD below never runs tools.deps: a clone's engine sits behind the
# cage wall with no internet, and `clojure -M:dev` at boot could reach
# for Maven (a cache it judged stale, another HOME) and die there.
RUN cd workqueue10 && clojure -P -M:dev && clojure -Spath -M:dev > /app/classpath

# Sources: the framework and the app, run from source (a home-cluster
# app; JVM boot beats maintaining a build pipeline).
COPY waymark10/ waymark10/
COPY calendar10/ calendar10/
COPY factory10/ factory10/
COPY factorykit/ factorykit/
COPY workqueue10/ workqueue10/
# The orgs (ticket 29f8e07a): no deps root, read from disk at boot.
# The engine serves each one whose org.edn says :live true, from
# WAYMARK10_ORGS_DIR, which is ../orgs from the WORKDIR below unless set.
COPY orgs/ orgs/

WORKDIR /app/workqueue10
EXPOSE 8014

# WORKQUEUE10_DSN / _PORT / _CHOREPLAN_URL / _MEALPLAN_URL arrive from
# the Nomad job — a queue with no source URLs serves the fakes, which
# is a dev posture, not a deployment. Production posture:
# WAYMARK10_AUTO_MIGRATE stays unset — boot REFUSES on schema drift
# and names the plan; the deploy gate runs `clojure -M:migrate`
# (APPLY=1) before rolling.
# A plain JVM on the baked classpath — the :dev alias's main, with no
# download at start. clojure.main.report=stderr puts a fatal boot
# error's whole report on stderr, where the job's log reads it, not in
# a /tmp file that dies with the container. The heap follows the
# job's memory limit instead of the JVM's quarter-of-RAM default, at
# 50% and not 75%: non-heap for a Clojure-from-source JVM (metaspace,
# code cache, thread stacks, GC structures) needs about a third of the
# cap, and at 75% the process crossed the 768 MB limit and was
# OOM-killed by the kernel. ExitOnOutOfMemoryError makes a real heap
# exhaustion exit with a logged reason instead of thrashing, and
# -Xlog:gc puts one line per collection on stderr, so the job's log
# carries a trace of the next memory problem.
CMD ["sh", "-c", "exec java -XX:MaxRAMPercentage=50 -XX:+ExitOnOutOfMemoryError -Xlog:gc:stderr:time,uptime -Dclojure.main.report=stderr -cp \"$(cat /app/classpath)\" clojure.main -m workqueue10.main"]
