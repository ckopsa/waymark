# selfhost/.env — copy this file to .env beside compose.yml and fill it in.

# The database's password; only the engine uses it, over compose's network.
POSTGRES_PASSWORD=change-me

# Your member id: the solo owner the dev headers resolve to, and the seed's owner.
WAYMARK_OWNER=you

# The repository the factory builds in, as owner/repo.
WAYMARK_REPO=you/your-repo

# The model the four seats are held for, as the harness names it.
WAYMARK_MODEL=claude-opus-5

# The token localfire presents when it asks for fires (pull mode); any long random string.
WAYMARK_PULL_TOKEN=change-me-too

# The host port the engine is published on, on 127.0.0.1 only.
WAYMARK_PORT=8014

# The bench's git token: clone, push and landing (a fine-grained token, waymark-bench docs/credential.md).
BENCH_GIT_TOKEN=github_pat_...

# The bench's GitHub token: feedback reads pull requests and checks; empty uses BENCH_GIT_TOKEN.
BENCH_GITHUB_TOKEN=

# The engine's image; the default follows main.
WAYMARK_IMAGE=ghcr.io/ckopsa/workqueue10:latest

# The bench's image.
BENCH_IMAGE=ghcr.io/ckopsa/waymark-bench:latest
