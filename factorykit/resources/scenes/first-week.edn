;; The first week of an org, as a scene (docs/spec-scenes.md): the film
;; the director makes of an org's simulated first week on a clone,
;; before the person merges it. Epic cafa6106, M3d. factory10.first-week
;; renders it from the org's seed: :opening, then :day once for each of
;; the :days the world seat plays (seats/world.edn), then :closing, whose
;; `$list` holds :closing_kind for {{kinds}} once for each success end of
;; each kind the seed's steps make, :closing_money for {{money}} when one
;; of them names an amount field, and the taps: four clauses at most
;; (tickets 3173de32, 8a21a8b9). The opening is :opening_bare when the
;; org has no brief. The holds come to 41 seconds.
{:template
 {:params {:seed "The org's seed name, its seed.edn's :seed."
           :org_display "The org's name as a person reads it: its first domain's :label."
           :brief_line "The first sentence of the org's brief, cut at 140 characters."
           :day_one "Day 1's date (YYYY-MM-DD)."
           :week_end "The day after the last day, where the week's holes end."
           :each_kind "In :closing_kind: one kind the seed's steps make rows of."
           :each_state "In :closing_kind: one of that kind's terminal states that is no loss."
           :each_one "In :closing_kind: the kind's noun and that state, for one row: prospect engaged."
           :each_many "In :closing_kind: the same, for many: prospects engaged."
           :money_kind "In :closing_money: the first kind the seed's steps make with an amount field."
           :money_field "In :closing_money: that field, a number named amount, total or fee."
           :owner "The cast id of the person filmed: the seed's approver, or its first cast member."
           :owner_display "That person's :display."
           :kind "The kind the world seat knocks on: the one the seed's first create makes, unless named."
           :kind_plural "That kind's collection, its registry :plural: the shots open it, wherever the nav draws the kind."
           :clone_url "Where the clone of the org is served. An input: this repo starts no clone."
           :head_sha "The commit of the org the clone was made at."}
  :day_params {:day "The day, 1 to :days." :date "The day's date: day_one plus day-1 days (YYYY-MM-DD)."
               :weekday "The date's day name: Monday."
               :next_date "The day after :date, where the day's holes end."}
  :days 7
  ;; the arc film rule reads friction, turn, payoff in order: on the
  ;; caption of these days, and on the closing
  :roles {2 "friction" 5 "turn"}
  ;; every scene rendered from this template is a first week, and says so
  ;; as :first-week: the film rules judge its take by the week's rules
  ;; though its shots carry no role (ticket 78da0888)
  :first-week true
  :note "Perform it only on a clone, never on an org that is live: the week it films was played by the world seat."}
 :scene
 {:title "The first week of {{org_display}}"
  :seed "{{seed}}"
  :devices ["phone"]
  :cast ["{{owner}}"]}
 :opening
 [{:open {:collection "{{kind_plural}}"}}
  {:hold {:ms 3000} :say "{{org_display}}. {{brief_line}}"}]
 :opening_bare
 [{:open {:collection "{{kind_plural}}"}}
  {:hold {:ms 3000} :say "{{org_display}}."}]
 ;; one day: its weekday, then the org's day in one sentence, filled from
 ;; the clone when the shot plays (docs/spec-scenes.md, Holes in a say):
 ;; what moved on day {{day}} of the clone's clock, between its (day-1)th
 ;; and day-th clock_shift, for the week is played by the clone's own
 ;; world and mayor seats, before the performance or as meanwhile shots.
 ;; The weekday is a label.
 :day
 [{:open {:collection "{{kind_plural}}"}}
  {:hold {:ms 5000}
   :say ["{{weekday}}. "
         {"$day" {:window "clock" :day "{{day}}" :domain "{{seed}}"}}]}]
 ;; the week's numbers, most consequential first: each kind's rows that
 ;; ended the week in each success end, the money a kind with an amount
 ;; field invoiced, then the held calls it asked the person. A zero drops
 ;; its clause, and a week of zeros is a quiet one.
 :closing_kind
 {"$rows" {:kind "{{each_kind}}" :state "{{each_state}}" :since "{{day_one}}" :until "{{week_end}}"
           :field "updated_at" :count true :one "{{each_one}}" :many "{{each_many}}"}}
 :closing_money
 {"$rows" {:kind "{{money_kind}}" :since "{{day_one}}" :until "{{week_end}}"
           :sum "{{money_field}}" :one "invoiced" :many "invoiced"}}
 :closing
 [{:hold {:ms 3000} :role "payoff"
   :say [{"$list" {:lead "That was the week: " :none "A quiet week"
                   :items ["{{kinds}}"
                           "{{money}}"
                           {"$rows" {:kind "held_call" :since "{{day_one}}" :until "{{week_end}}"
                                     :count true :one "tap from you" :many "taps from you"}}]}}
         ". Merge to make it real."]}]
 :clone {:url "{{clone_url}}" :head_sha "{{head_sha}}"}}
