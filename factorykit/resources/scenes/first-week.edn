;; The first week of an org, as a scene (docs/spec-scenes.md): the film
;; the director makes of an org's simulated first week on a clone,
;; before the person merges it. Epic cafa6106, M3d. factory10.first-week
;; renders it from the org's seed: :opening, then :day once for each of
;; the :days the world seat plays (seats/world.edn), then :closing. The
;; holds come to 38 seconds; with the taps, about 45.
{:template
 {:params {:seed "The org's seed name, its seed.edn's :seed."
           :org_display "The org's name as a person reads it: its first domain's :label."
           :owner "The cast id of the person filmed: the seed's approver, or its first cast member."
           :owner_display "That person's :display."
           :kind "The kind the world seat knocks on: the one the seed's first create makes, unless named."
           :clone_url "Where the clone of the org is served. An input: this repo starts no clone."
           :head_sha "The commit of the org the clone was made at."}
  :day_params {:day "The day, 1 to :days." :date "The day's date: day_one plus day-1 days (YYYY-MM-DD)."
               :next_date "The day after :date, where the day's holes end."}
  :days 7
  ;; the arc film rule reads friction, turn, payoff in order: on the
  ;; caption of these days, and on the closing
  :roles {2 "friction" 5 "turn"}
  :note "Perform it only on a clone, never on an org that is live: the week it films was played by the world seat."}
 :scene
 {:title "The first week of {{org_display}}"
  :seed "{{seed}}"
  :devices ["phone"]
  :cast ["{{owner}}"]
  :given [{:as "{{owner}}" :tool "waymark_query" :bind "week"
           :arguments {:kind "{{kind}}" :return "summary"}}]}
 :opening
 [{:tap {:surface "nav.{{kind}}"} :say "The first week of {{org_display}}."}]
 ;; one day: what came in, what the house did, what it asked the person.
 ;; Each hole is filled from the clone's rows of that day when the shot
 ;; plays (docs/spec-scenes.md, Holes in a say).
 :day
 [{:tap {:surface "nav.{{kind}}"}}
  {:hold {:ms 5000}
   :say ["Day {{day}}, {{date}}. In came: "
         {"$rows" {:kind "{{kind}}" :since "{{date}}" :until "{{next_date}}"}}
         ". What {{org_display}} did: "
         {"$moves" {:kind "{{kind}}" :since "{{date}}" :until "{{next_date}}"
                    :by "seats" :none "nothing moved"}}
         ". What it asked {{owner_display}}: "
         {"$rows" {:kind "held_call" :since "{{date}}" :until "{{next_date}}"
                   :none "no held call"}}
         "; "
         {"$rows" {:kind "approval_request" :since "{{date}}" :until "{{next_date}}"
                   :none "no approval request"}}
         "."]}]
 :closing
 [{:hold {:ms 3000} :role "payoff" :say "That was the week. Merge to make it real."}]
 :clone {:url "{{clone_url}}" :head_sha "{{head_sha}}"}}
