;; week_fixture's seed: what a fresh engine holds the moment it boots
;; this org. The grammar is docs/orgkit.md § The seed.
{:seed "week_fixture"
 :version 1
 :org "week_fixture"
 :domains [{:name "week_fixture" :label "Week Fixture Gardening" :ref :week_fixture}]
 :cast
 {:owner {:id "owner" :display "Rosa Delgado" :type :human :roles ["approver"]}}
 ;; the outside world, which only a clone loads: a homeowner who asks
 ;; for jobs, and the world seat that plays their week
 :rehearsal
 {:cast {:ana {:id "ana" :display "Ana Ruiz" :type :human
               :scope [{:kind "garden_job" :actions ["create"]}]}
         :bookkeeper {:id "bookkeeper" :display "The Bookkeeper" :type :human
                      :scope [{:kind "integration" :actions ["approve"]}]}}
  :seats [{:template "world"
           :params {:brief "Week Fixture Gardening trims hedges and mows lawns for homeowners, who ask it for jobs."
                    :kinds "garden_job" :cast "ana" :day_one [:days 0]
                    :domain_id [:ref :week_fixture]}}]
  ;; a param no environment gives: the week fills it with a stand-in
  ;; and the homeowners' booking site that holds it, whose events a
  ;; week may post; its creator cannot approve it, so the bookkeeper does
  :steps [{:as :owner :kind :secret :ref :signing
           :create {:name "fixture-signing" :value [:param :signing_secret_fixture]}}
          {:as :owner :kind :integration :ref :fixture
           :create {:name "fixture" :system "The homeowners' booking site" :secret [:ref :signing]}}
          {:as :bookkeeper :on :fixture :action :approve}]}
 :seats
 [{:seat {:name "job-clerk"
          :mode "fired"
          :walk "garden_job"
          :rows_per_firing 1
          :cadence_seconds 3600
          :standing_ttl_seconds 604800
          :budget_usd_per_week 5M
          :sitting_budget_tokens 60000
          :charter "You read each job. Quote it when the homeowner says their budget, ask for the owner's tap to book a quoted one, and decline work this office does not do. Say why in one sentence."
          :scope [{:kind "garden_job" :actions ["quote" "book" "decline"]}]
          :wake_on [{:kind "garden_job" :actions ["create" "quote"]}]}}
  {:seat {:name "front-desk"
          :mode "fired"
          :walk "patient"
          :rows_per_firing 1
          :cadence_seconds 3600
          :standing_ttl_seconds 604800
          :budget_usd_per_week 5M
          :sitting_budget_tokens 60000
          :charter "You admit each waiting patient, filing the consent form they bring, and sign a visit once its patient's consent form is on file. Say why in one sentence."
          :scope [{:kind "patient" :actions ["admit"]} {:kind "clinic_visit" :actions ["sign"]}]
          :wake_on [{:kind "patient" :actions ["create"]} {:kind "clinic_visit" :actions ["create"]}]}}]
 :judgments []
 :steps []}
