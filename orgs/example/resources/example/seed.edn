;; example's seed: what a fresh engine holds the moment it boots this
;; org. The grammar is docs/orgkit.md § The seed: the demo seed's
;; :cast and :steps (docs/spec-demo-clones.md § 1) under the org's
;; :domains, :seats and :judgments.
{:seed "example"
 :version 1
 :org "example"
 :domains [{:name "example" :label "Example Landscaping" :ref :example}]
 :cast
 {:owner {:id "owner" :display "Rosa Delgado" :type :human :roles ["approver"]}
  :crew  {:id "crew"  :display "Lee Park"     :type :human}}
 ;; the outside world, which only a clone loads (ticket a4149376): a
 ;; customer who files requests, and the world seat that plays their week
 :rehearsal
 {:cast {:ana {:id "ana" :display "Ana Ruiz" :type :human
               :scope [{:kind "request" :actions ["create"]}]}}
  :seats [{:template "world"
           :params {:brief "Example Landscaping trims hedges and mows lawns for homeowners, who send it requests for the work."
                    :kinds "request" :cast "ana" :day_one [:days 0]
                    :domain_id [:ref :example]}}]}
 ;; one seat. No factorykit template walks a request, so it is a whole
 ;; seat map under :seat, in the shape a template's :seat takes
 :seats
 [{:seat {:name "office-clerk"
          :mode "fired"
          :walk "request"
          :rows_per_firing 1
          :cadence_seconds 3600
          :standing_ttl_seconds 604800
          :budget_usd_per_week 5M
          :sitting_budget_tokens 60000
          :charter "You read each new request. Accept it when its detail says what the work is, and write the work order it becomes; decline it when it is not work this office does. Say why in one sentence."
          :scope [{:kind "request" :actions ["accept" "decline"]}
                  {:kind "work_order" :actions ["create"]}]}
   :wakes [{:kind "request" :actions ["create"]}]}
  ;; the crew's seat: a scheduled work order is left by it, and by
  ;; nobody else, so without it the conformance suite finds no_exit
  {:seat {:name "crew-lead"
          :mode "fired"
          :walk "work_order"
          :rows_per_firing 1
          :cadence_seconds 3600
          :standing_ttl_seconds 604800
          :budget_usd_per_week 5M
          :sitting_budget_tokens 60000
          :charter "You read each scheduled work order. Complete it when its crew has done the work; cancel it when the work will not be done. Say why in one sentence."
          :scope [{:kind "work_order" :actions ["complete" "cancel"]
                   :filter {:state "scheduled"}}]}
   :wakes [{:kind "work_order" :actions ["create"]}]}]
 :judgments []
 :steps
 [{:as :owner :kind :request :ref :hedge
   :create {:title "Trim the front hedge" :customer "Ana Ruiz"
            :detail "Front hedge, about 20 metres, trimmed to waist height before the 30th."}}
  {:as :owner :kind :request :on :hedge :action "accept"}
  {:as :owner :kind :work_order :ref :hedge-job
   :create {:title "Trim the front hedge" :crew "crew"}}
  {:as :owner :kind :request :ref :lawn
   :create {:title "Weekly lawn mowing" :customer "Ben Cole"}}]}
