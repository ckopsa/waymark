;; shop_rehearsal's first week, Monday to Friday (docs/orgkit.md § The week)
{:day-one "2026-10-26"
 :card "Handmade Ceramics Shop: mugs, bowls and planters thrown and fired in batches, sold online and to a few cafes on net-30."
 :goal {:kind "wholesale_order" :state "shipped"}
 :days
 [{:day 1
   :card "Monday. Corner Cup Cafe asks to buy wholesale, and Maya orders two of the last four serving bowls."
   :calls [{:as :world :cast :cafe :kind "wholesale_account" :action "create" :name "corner" :input {:cafe "Corner Cup Cafe" :contact "orders@cornercup.example" :billing_state "CO" :terms_days 30}}
           {:as :mayor :kind "wholesale_account" :action "approve" :row "corner" :show true}
           {:as :world :cast :maya :kind "order" :action "create" :name "maya-bowls" :input {:customer "Maya Chen" :email "maya@example.com" :items "2 × Ash-glaze serving bowl" :quantity 2 :subtotal_cents 11600 :buyer_state "CO" :tax_cents 336 :total_cents 11936 :placed_on "2026-10-26"}}
           {:as :world :cast :processor :kind "payment" :action "create" :name "maya-pay" :input {:processor_ref "ch_3QmayA01" :order_id {"$row" "maya-bowls"} :amount_cents 11936 :fee_cents 376 :cleared_on "2026-10-26"}}
           {:as :mayor :kind "payment" :action "apply" :row "maya-pay"}
           {:as :mayor :kind "order" :action "mark_paid" :row "maya-bowls" :input {:payment_id {"$row" "maya-pay"}} :show true}]}
  {:day 2
   :card "Tuesday. Staff One packs Maya's bowls; Corner Cup orders 24 speckled mugs at $16 each."
   :calls [{:as :mayor :kind "order" :action "pack" :row "maya-bowls" :input {:packed_by "staff1"}}
           {:as :world :cast :cafe :kind "wholesale_order" :action "create" :name "corner-mugs" :input {:cafe "Corner Cup Cafe" :account_id {"$row" "corner"} :items "24 × Speckled stoneware mug at $16.00" :total_cents 38400}}
           {:as :mayor :kind "wholesale_order" :action "accept" :row "corner-mugs" :input {:account_standing "good"} :show true}]}
  {:day 3
   :card "Wednesday. The carrier sells one label for Maya's parcel; it ships on day two of three, on time."
   :calls [{:as :world :cast :carrier :kind "shipping_label" :action "create" :name "maya-label" :input {:order_id {"$row" "maya-bowls"} :tracking "1Z999AA10123456784" :postage_cents 1240}}
           {:as :mayor :kind "shipping_label" :action "use" :row "maya-label"}
           {:as :mayor :kind "order" :action "ship" :row "maya-bowls" :input {:label_id {"$row" "maya-label"} :paid_on "2026-10-26"} :show true}]}
  {:day 4
   :card "Thursday. Maya's parcel arrives with one bowl cracked. She wants a replacement; the claim goes to the carrier."
   :calls [{:as :mayor :kind "order" :action "deliver" :row "maya-bowls"}
           {:as :world :cast :maya :kind "breakage_claim" :action "create" :name "maya-crack" :input {:customer "Maya Chen" :order_id {"$row" "maya-bowls"} :item "Ash-glaze serving bowl" :detail "One of the two bowls arrived cracked through the rim; the box was crushed at one corner." :remedy "replacement"}}
           {:as :mayor :kind "breakage_claim" :action "claim" :row "maya-crack" :input {:carrier_claim_ref "UPS-CLM-48213" :remedy "replacement"} :show true}]}
  {:day 5
   :card "Friday. Corner Cup's 24 mugs ship, billed on invoice W-1001 for $384.00, due net-30."
   :calls [{:as :mayor :kind "invoice" :action "create" :name "w1001" :input {:number "W-1001" :account_id {"$row" "corner"} :wholesale_order_id {"$row" "corner-mugs"} :amount_cents 38400 :tax_cents 0 :issued_on "2026-10-30"}}
           {:as :mayor :kind "wholesale_order" :action "ship" :row "corner-mugs" :input {:invoice_id {"$row" "w1001"}} :show true}]}]}
