;; shop_rehearsal's seed: what a fresh engine holds the moment it boots
;; this org. The grammar is docs/orgkit.md § The seed.
{:seed "shop_rehearsal"
 :version 1
 :org "shop_rehearsal"
 :domains [{:name "shop_rehearsal" :label "Handmade Ceramics Shop" :ref :shop_rehearsal}]
 ;; the owner is the plan's filing member; the two part-time staff pack
 ;; orders and inspect returns
 :cast
 {:owner  {:id "2bf3541f-6c57-4042-99c0-b0f5c5270594" :display "The Owner" :type :human :roles ["approver"]}
  :staff1 {:id "staff1" :display "Part-time Staff One" :type :human :roles ["packer" "inspector"]}
  :staff2 {:id "staff2" :display "Part-time Staff Two" :type :human :roles ["packer" "inspector"]}}
 ;; the outside world, which only a clone loads: a retail customer, a
 ;; cafe that buys wholesale, and the payment processor, each creating
 ;; what they send; the world seat plays their first week
 :rehearsal
 {:cast {:maya      {:id "maya" :display "Maya Chen" :type :human
                     :scope [{:kind "order" :actions ["create"]}
                             {:kind "return_request" :actions ["create"]}
                             {:kind "breakage_claim" :actions ["create"]}]}
         :cafe      {:id "cafe" :display "Corner Cup Cafe" :type :human
                     :scope [{:kind "wholesale_account" :actions ["create"]}
                             {:kind "wholesale_order" :actions ["create"]}]}
         :processor {:id "processor" :display "Payment Processor" :type :agent
                     :scope [{:kind "payment" :actions ["create"]}]}
         ;; the carrier sells the shop its postage: one label per order
         :carrier   {:id "carrier" :display "Parcel Carrier" :type :agent
                     :scope [{:kind "shipping_label" :actions ["create"]}]}}
  :seats [{:template "world"
           :params {:brief "A small online shop selling handmade ceramics: mugs, bowls and planters the owner throws and fires in batches. Customers order and pay at checkout through the payment processor; orders ship within 3 business days; returns are accepted within 30 days of delivery for unbroken items; breakage in transit ends in a replacement or refund; a few cafes buy wholesale on net-30 invoices."
                    :kinds "order,payment,shipping_label,return_request,breakage_claim,wholesale_account,wholesale_order"
                    :cast "maya,cafe,processor,carrier" :day_one [:days 0]
                    :domain_id [:ref :shop_rehearsal]}}]}
 ;; the org's mayor holds every door out of every state; doors that
 ;; wait on the owner hold for her tap in the kind itself
 :seats
 [{:template "org-mayor"
   :params {:org "shop_rehearsal" :domain "shop_rehearsal" :domain_id [:ref :shop_rehearsal]
            :owner "2bf3541f-6c57-4042-99c0-b0f5c5270594" :budget_usd_per_week 8M
            :kinds [{:kind "product" :actions ["retire"]}
                    {:kind "kiln_batch" :actions ["stock" "lose"]}
                    {:kind "order" :actions ["mark_paid" "cancel" "pack" "ship" "deliver"]}
                    {:kind "payment" :actions ["apply" "fail"]}
                    {:kind "shipping_label" :actions ["use" "void"]}
                    {:kind "return_request" :actions ["receive" "decline" "restock" "reject"]}
                    {:kind "refund" :actions ["approve" "send" "decline"]}
                    {:kind "breakage_claim" :actions ["claim" "settle" "deny"]}
                    {:kind "wholesale_account" :actions ["approve" "decline" "close"]}
                    {:kind "invoice" :actions ["create" "pay" "mark_overdue" "void"]}
                    {:kind "wholesale_order" :actions ["accept" "decline" "ship"]}
                    {:kind "monthly_close" :actions ["balance"]}]
            ;; every door that lands a row in a state the mayor leaves
            :wakes [{:kind "product" :actions ["create"]}
                    {:kind "kiln_batch" :actions ["create"]}
                    {:kind "order" :actions ["create" "mark_paid" "pack" "ship"]}
                    {:kind "payment" :actions ["create"]}
                    {:kind "shipping_label" :actions ["create"]}
                    {:kind "return_request" :actions ["create" "receive"]}
                    {:kind "refund" :actions ["create" "approve"]}
                    {:kind "breakage_claim" :actions ["create" "claim"]}
                    {:kind "wholesale_account" :actions ["create" "approve"]}
                    {:kind "invoice" :actions ["create" "mark_overdue"]}
                    {:kind "wholesale_order" :actions ["create" "accept"]}
                    {:kind "monthly_close" :actions ["create"]}]}}]
 :judgments []
 :steps
 [{:as :owner :kind :product :ref :mug
   :create {:name "Speckled stoneware mug" :line "mug" :price_cents 3200 :on_hand 12}}
  {:as :owner :kind :product :ref :bowl
   :create {:name "Ash-glaze serving bowl" :line "bowl" :price_cents 5800 :on_hand 4}}
  {:as :owner :kind :product :ref :planter
   :create {:name "Small terracotta planter" :line "planter" :price_cents 2400 :on_hand 9}}
  {:as :owner :kind :kiln_batch :ref :batch1
   :create {:title "October mug firing" :pieces 20}}]}
