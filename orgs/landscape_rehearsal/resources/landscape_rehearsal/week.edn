;; landscape_rehearsal's first week (docs/orgkit.md § The week): the
;; Elm crew (a team row the seed makes) builds the Hendersons' $14,800
;; patio and planting Monday to Friday, one $2,960 booking per crew day;
;; the Parks' $12,600 irrigation quote waits for the owner's tap;
;; Wednesday's pavers run over their quote; Thursday the Oak crew files
;; two photos of the Parks' yard and finishes the visit; Friday the job
;; is done and its invoice goes out through the payments integration.
{:day-one "2026-10-26"
 :card "A landscaping company's last week of the season: the Elm crew builds the Hendersons' patio and planting, and the Parks want new irrigation."
 :goal {:kind "booking" :state "invoiced"}
 :days [{:day 1
         :card "Monday. The Hendersons' deposit cleared last week, so the Elm crew, led by Ana, starts their $14,800 patio and planting."
         :calls [{:as :world :cast :hendersons :kind "booking" :action "create" :name "hend_mon"
                  :input {:customer_name "the Hendersons' patio" :crew {"$row" "elm"} :lead "ana"
                          :price {:amount "2960.00" :currency "USD"}
                          :starts_at "2026-10-26T08:00:00Z" :ends_at "2026-10-26T17:00:00Z"}}
                 {:as :mayor :kind "booking" :action "start" :row "hend_mon"}
                 {:as :mayor :kind "booking" :action "finish" :row "hend_mon"}]}
        {:day 2
         :card "Tuesday. The Oak crew measures the Parks' yard for drip irrigation; the quote comes to $12,600, over the owner's $10,000 line."
         :calls [{:as :mayor :kind "booking" :action "create" :name "hend_tue"
                  :input {:customer_name "the Hendersons' patio" :crew {"$row" "elm"}
                          :price {:amount "2960.00" :currency "USD"}
                          :starts_at "2026-10-27T08:00:00Z" :ends_at "2026-10-27T17:00:00Z"}}
                 {:as :world :cast :parks :kind "booking" :action "create" :name "parks_measure"
                  :input {:customer_name "the Parks' irrigation" :crew {"$row" "oak"}
                          :price {:amount "12600.00" :currency "USD"}
                          :starts_at "2026-10-27T08:00:00Z" :ends_at "2026-10-27T12:00:00Z"}}
                 {:as :mayor :kind "booking" :action "send_quote" :row "parks_measure"
                  :input {:quote_cents 1260000} :show true}
                 {:as :mayor :kind "booking" :action "finish" :row "hend_tue"}]}
        {:day 3
         :card "Wednesday. Pavers down at the Hendersons', but the stone ran $3,400 against the day's $2,960 quote, so the owner hears the job is over quote."
         :calls [{:as :mayor :kind "booking" :action "create" :name "hend_wed"
                  :input {:customer_name "the Hendersons' patio" :crew {"$row" "elm"}
                          :quoted_by "2bf3541f-6c57-4042-99c0-b0f5c5270594"
                          :price {:amount "2960.00" :currency "USD"}
                          :cost_so_far {:amount "3400.00" :currency "USD"}
                          :starts_at "2026-10-28T08:00:00Z" :ends_at "2026-10-28T17:00:00Z"}
                  :show true}
                 {:as :mayor :kind "booking" :action "finish" :row "parks_measure"}
                 {:as :mayor :kind "booking" :action "finish" :row "hend_wed"}]}
        {:day 4
         :card "Thursday. The Elm crew sets the Hendersons' border plantings; the Oak crew mows the Parks' yard and files two photos before the visit is done."
         :calls [{:as :mayor :kind "booking" :action "create" :name "hend_thu"
                  :input {:customer_name "the Hendersons' patio" :crew {"$row" "elm"}
                          :price {:amount "2960.00" :currency "USD"}
                          :starts_at "2026-10-29T08:00:00Z" :ends_at "2026-10-29T17:00:00Z"}}
                 {:as :mayor :kind "booking" :action "finish" :row "hend_thu"}
                 {:as :mayor :kind "visit" :action "add_photos" :row "parks_visit"
                  :input {:photos []}
                  :attach [{:field :photos :name "parks-front.jpg" :type "image/jpeg"}
                           {:field :photos :name "parks-back.jpg" :type "image/jpeg"}]}
                 {:as :mayor :kind "visit" :action "finish" :row "parks_visit" :show true}]}
        {:day 5
         :card "Friday. The crew lead marks the patio done, and the Hendersons' invoice goes out through the payment processor, due in 15 days."
         :calls [{:as :mayor :kind "booking" :action "create" :name "hend_fri"
                  :input {:customer_name "the Hendersons' patio" :crew {"$row" "elm"}
                          :price {:amount "2960.00" :currency "USD"}
                          :starts_at "2026-10-30T08:00:00Z" :ends_at "2026-10-30T15:00:00Z"}}
                 {:as :mayor :kind "booking" :action "start" :row "hend_fri"}
                 {:as :mayor :kind "booking" :action "finish" :row "hend_fri"}
                 {:as :mayor :kind "booking" :action "send_invoice" :row "hend_fri" :show true}]}]}
