;; clinic_rehearsal's seed: what a fresh engine holds the moment it
;; boots this org. The grammar is docs/orgkit.md § The seed.
{:seed "clinic_rehearsal"
 :version 1
 :org "clinic_rehearsal"
 :domains [{:name "clinic_rehearsal" :label "Outpatient PT Clinic" :ref :clinic_rehearsal}]
 ;; the clinic's team. The owner is a physical therapist; "clinician"
 ;; is whoever may write and sign a note, PT or assistant. The insurers
 ;; are outside parties, named on claims, never on the team
 :cast
 {:owner   {:id "2bf3541f-6c57-4042-99c0-b0f5c5270594" :display "The Owner (PT)" :type :human
            :roles ["approver" "pt" "clinician"]}
  :pt_a    {:id "pt_a"    :display "Dana Holt (PT)"     :type :human :roles ["pt" "clinician"]}
  :pt_b    {:id "pt_b"    :display "Sam Ortiz (PT)"     :type :human :roles ["pt" "clinician"]}
  :pta     {:id "pta"     :display "Jo Kim (PTA)"       :type :human :roles ["pta" "clinician"]}
  :desk    {:id "desk"    :display "Ari Lane (front desk)" :type :human :roles ["front_desk"]}
  :billing {:id "billing" :display "Mo Reyes (billing)" :type :human :roles ["billing"]}
  :acme    {:id "acme"    :display "Acme Health"        :type :outside :roles ["insurer"]}
  :blue_plains {:id "blue_plains" :display "Blue Plains" :type :outside :roles ["insurer"]}}
 ;; the outside world, which only a clone loads: physicians who send referrals
 :rehearsal
 {:cast {:dr_vance {:id "dr_vance" :display "Dr. Lena Vance" :type :human
                    :scope [{:kind "referral" :actions ["create"]}]}
         :dr_okafor {:id "dr_okafor" :display "Dr. Tobi Okafor" :type :human
                     :scope [{:kind "referral" :actions ["create"]}]}}
  :seats [{:template "world"
           :params {:brief "We are a small outpatient physical therapy clinic. A physician refers a patient by sending a prescription; we cannot book a first visit until we have it, and it expires after 90 days."
                    :kinds "referral" :cast "dr_vance,dr_okafor" :day_one [:days 0]
                    :domain_id [:ref :clinic_rehearsal]}}]
  :effects {"insurer.submit_claim" {:status "done" :result {:claim_number "ACME-1009"}}
            "insurer.check_coverage" {:status "done" :result {:coverage "verified"}}
            "messaging.send_reminder" {:status "done" :result {:sent true}}}
  ;; each integration's signing secret, a value only the clone knows
  :steps [{:as :owner :kind :secret :ref :insurer-signing :create {:name "insurer-signing" :value [:param :signing_secret_insurer]}}
          {:as :owner :kind :secret :ref :messaging-signing :create {:name "messaging-signing" :value [:param :signing_secret_messaging]}}]}
 :seats
 [{:template "org-mayor"
   :params {:org "clinic_rehearsal" :domain "clinic_rehearsal"
            :domain_id [:ref :clinic_rehearsal]
            :owner "2bf3541f-6c57-4042-99c0-b0f5c5270594" :budget_usd_per_week 8M
            :kinds [{:kind "referral" :actions ["accept" "decline" "expire"]}
                    {:kind "patient" :actions ["create" "check_coverage" "admit" "discharge" "purge"]}
                    {:kind "plan_of_care" :actions ["create" "activate" "resign" "end" "lapse"]}
                    {:kind "visit" :actions ["create" "remind" "attend" "sign" "no_show" "cancel"]}
                    {:kind "claim" :actions ["create" "submit" "post_payment" "deny" "resubmit" "write_off" "bill_patient"]}]
            :wakes [{:kind "referral" :actions ["create"]}
                    {:kind "patient" :actions ["create" "admit" "discharge"]}
                    {:kind "plan_of_care" :actions ["create" "activate" "resign"]}
                    {:kind "visit" :actions ["create" "attend"]}
                    {:kind "claim" :actions ["create" "submit" "resubmit" "post_payment" "deny"]}]}}]
 :judgments []
 :steps
 [{:as :owner :kind :referral :ref :ref-1
   :create {:patient_name "Pat Example" :physician "Dr. Lena Vance"
            :prescription "PT eval and treat, left knee, post-op."}}
  {:as :owner :kind :patient :ref :pat-1
   :create {:name "Pat Example" :insurer "acme"}}]}
